# Copy this file to .env and fill in real values. .env is git-ignored; this template is not.

# Award availability (Seats.aero)
SEATS_AERO_API_KEY=

# Cash fares (SerpApi Google Flights; free plan is 250 searches/month)
SERPAPI_API_KEY=

# Notifications (ntfy). The topic is effectively a password on the public ntfy.sh server:
# make it long and random, and never share it. Subscribe to it in the ntfy app.
NTFY_TOPIC=
# Optional: a self-hosted server. Defaults to https://ntfy.sh
# NTFY_SERVER=

# The Claude advisor (`advise` command). Pay-per-use API billing, no subscription: create a key at
# console.anthropic.com and set a spend limit there. Optional; nothing else needs it.
ANTHROPIC_API_KEY=
# Optional: which model answers. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=

# Storage
DATABASE_PATH=flight_optimizer.db

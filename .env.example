# Copy this file to .env and fill in real values. .env is git-ignored; this template is not.

# Award availability (Seats.aero)
SEATS_AERO_API_KEY=

# Cash fares: fill in whichever source you choose (Amadeus, Skyscanner, or Kiwi.com)
CASH_FARE_API_KEY=
# Amadeus uses a client id and secret instead of a single key:
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# Notifications: fill in whichever channel you choose
# ntfy.sh
# NTFY_TOPIC=
# Pushover
# PUSHOVER_USER_KEY=
# PUSHOVER_APP_TOKEN=

# Storage
DATABASE_PATH=flight_optimizer.db
